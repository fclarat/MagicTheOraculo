rules_version = '2';
// Security rules for the "searches" collection (cards people looked for but the
// oracle did not pin down). Anyone may APPEND one; nobody can edit or delete.
// Read is open because the data is just card names -- it lets us aggregate them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /searches/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['name','inSet','path','ts'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.path.size() < 1000;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
